# Local secrets: copy to `.env` and fill in (`.env` is gitignored).

# Optional: override MapLibre style JSON. Default in code is OpenFreeMap dark (no key).
# https://openfreemap.org/quick_start
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Optional: API key for a tile provider that requires a token (MapTiler, Stadia, etc.).
# Appended to NEXT_PUBLIC_MAP_STYLE_URL as ?key=<value> when set.
# NEXT_PUBLIC_MAP_API_KEY=

# Optional: override path to carbon-footprint GeoJSON served from public/.
# Default is /data/carbon-footprint.geojson (public/data/carbon-footprint.geojson).
# NEXT_PUBLIC_CARBON_DATA_URL=/data/carbon-footprint.geojson

# Genkit + Gemini (risk/scenario/grant API routes)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: richer onboarding welcome copy via Claude; omitted = static fallback
# ANTHROPIC_API_KEY=

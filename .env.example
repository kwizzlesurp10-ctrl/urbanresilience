# Local secrets: copy to `.env` and fill in (`.env` is gitignored).

# Optional: MapLibre Style JSON URL (vector tiles). If unset, uses MapLibre demo tiles (no key).
# Examples: self-hosted style, Protomaps, OpenFreeMap, MapTiler (key in style URL), etc.
# NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Genkit + Gemini (risk/scenario/grant API routes)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: richer onboarding welcome copy via Claude; omitted = static fallback
# ANTHROPIC_API_KEY=

# Local secrets: copy to `.env` and fill in (`.env` is gitignored).

# ──────────────────────────────────────────────────────────────────
# Mapbox API
# ──────────────────────────────────────────────────────────────────
# Mapbox public access token — get one free at https://account.mapbox.com/
# When set, the map automatically switches to Mapbox dark-v11 tiles and
# injects this token into every Mapbox API request via transformRequest.
# Leave blank to use the free OpenFreeMap dark fallback (no key required).
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiPFlPVVJfVVNFUk5BTUUiLCJhIjoiPFlPVVJfVE9LRU4+In0.XXXXXXXXXXXXXXXXXXXX

# ──────────────────────────────────────────────────────────────────
# Map style (optional overrides)
# ──────────────────────────────────────────────────────────────────
# Explicit MapLibre style JSON URL — overrides NEXT_PUBLIC_MAPBOX_TOKEN.
# Default when blank: OpenFreeMap dark (no key) or Mapbox dark-v11 if token set.
# Example Mapbox styles:
#   mapbox://styles/mapbox/dark-v11
#   mapbox://styles/mapbox/streets-v12
#   mapbox://styles/mapbox/satellite-streets-v12
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Optional: API key for third-party tile providers (MapTiler, Stadia, etc.).
# Appended to NEXT_PUBLIC_MAP_STYLE_URL as ?key=<value> when set.
# NEXT_PUBLIC_MAP_API_KEY=

# Override path to carbon-footprint GeoJSON served from public/.
# Default: /data/carbon-footprint.geojson (public/data/carbon-footprint.geojson).
# NEXT_PUBLIC_CARBON_DATA_URL=/data/carbon-footprint.geojson

# ──────────────────────────────────────────────────────────────────
# AI / backend keys
# ──────────────────────────────────────────────────────────────────
# Genkit + Gemini (risk/scenario/grant API routes)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: richer onboarding welcome copy via Claude; omitted = static fallback
# ANTHROPIC_API_KEY=
